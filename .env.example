# Copy this file to .env (which is gitignored) for local `netlify dev`.
# In production, set these in Netlify dashboard → Site settings → Environment variables.

# From Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# From Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# On-site reviews (Netlify Blobs).
# This site's function runtime is missing the auto-injected NETLIFY_BLOBS_CONTEXT,
# so the reviews store connects in manual mode using SITE_ID (Netlify injects it)
# + this token. Create at: Netlify → User settings → Applications →
# Personal access tokens → New token. Then add NETLIFY_BLOBS_TOKEN in
# Site settings → Environment variables and redeploy.
NETLIFY_BLOBS_TOKEN=nfp_REPLACE_ME

# Signs the one-click Approve/Reject links in the owner review email.
REVIEW_MODERATION_SECRET=long_random_string
